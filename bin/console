#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . "/../vendor/autoload.php";

use Symfony\Component\Console\Application;
use App\Database;
use App\Repository\TaskRepository;
use App\Command\ListTasksCommand;
use App\Command\AddTaskCommand;

$repository = new TaskRepository(new Database);

$app = new Application("Task CLI", "1.0.0");
$app->addCommand(new ListTasksCommand($repository));
$app->addCommand(new AddTaskCommand($repository));
$app->run();
